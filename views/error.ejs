<!DOCTYPE html>
<html>
<head>
    <title>Error <%= status %></title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 40px; background: #fafafa; color: #222; }
        .box { max-width: 560px; margin: 0 auto; background: #fff; border: 1px solid #ddd; padding: 32px; }
        h1 { margin-top: 0; color: #b3261e; }
        a { color: #1a73e8; }
    </style>
</head>
<body>
    <div class="box">
        <h1>Error <%= status %></h1>
        <p><%= message %></p>
        <p><a href="/">Back to home</a></p>
    </div>
</body>
</html>