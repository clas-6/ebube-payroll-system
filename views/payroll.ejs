<!DOCTYPE html>
<html>
<body style="font-family: Arial; padding: 20px;">
    <%- include('partials/nav') %>
    <h1>Run Payroll</h1>
    <% if (error) { %><p style="color: red;"><%= error %></p><% } %>
    <form action="/calculate-payroll" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <p>
            <label>Period label:</label><br>
            <input type="text" name="period_label" maxlength="80" placeholder="e.g. 2026-01-01 to 2026-01-14">
            <small>(Leave blank to use today's date. Each label must be unique.)</small>
        </p>
        <h3>Enter hours worked for hourly employees:</h3>
        <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; text-align: left;">
            <tr><th>Name</th><th>Pay Type</th><th>Hours Worked</th></tr>
            <% employees.forEach(function(emp) { %>
                <tr>
                    <td><%= emp.name %></td>
                    <td><%= emp.pay_type === 'salary' ? 'Salaried' : 'Hourly' %></td>
                    <td>
                        <% if(emp.pay_type === 'hourly') { %>
                            <input type="number" step="0.5" min="0" max="1000" name="hours_<%= emp.id %>" value="40" required>
                        <% } else { %>
                            <em>N/A (Standard Bi-weekly)</em>
                        <% } %>
                    </td>
                </tr>
            <% }); %>
        </table>
        <br><button type="submit" style="padding: 10px; font-size: 16px;">Calculate Pay</button>
    </form>
</body>
</html>
