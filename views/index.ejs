<!DOCTYPE html>
<html>
<body style="font-family: Arial; padding: 20px;">
    <h1>Employee List</h1>
    <%- include('partials/nav') %>
    <% if (notice) { %><p style="color: green;"><%= notice %></p><% } %>
    <% if (error) { %><p style="color: red;"><%= error %></p><% } %>
    <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; text-align: left;">
        <tr><th>ID</th><th>Name</th><th>Pay Type</th><th>Rate</th></tr>
        <% employees.forEach(function(emp) { %>
            <tr>
                <td><%= emp.id %></td>
                <td><%= emp.name %></td>
                <td><%= emp.pay_type === 'salary' ? 'Salaried (Annual)' : 'Hourly' %></td>
                <td>$<%= emp.rate_display %></td>
            </tr>
        <% }); %>
    </table>
</body>
</html>
